{
  "name": "@fps4/maestro-specs-api",
  "version": "0.1.0",
  "private": true,
  "description": "Governed specification service \u2014 drafts, immutable versions, gates a named human passes, and the standards catalogue they are judged against.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "workspace:apply": "tsx src/cli/apply-workspace.ts",
    "workspace:validate": "tsx src/cli/validate-workspaces.ts",
    "workspace:seed": "tsx src/cli/seed.ts",
    "specs": "tsx src/cli/specs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fps4/maestro-spine": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "diff": "^7.0.0",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "markdown-it": "^14.1.0",
    "mongodb": "^6.12.0",
    "sanitize-html": "^2.14.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/diff": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.6",
    "@types/sanitize-html": "^2.13.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.6"
  },
  "bin": {
    "specs": "dist/cli/specs.js"
  }
}
