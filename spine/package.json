{
  "name": "@fps4/maestro-spine",
  "version": "0.1.0",
  "description": "The spine: maestro's record. The event envelope and its append rules, RFC 8785 canonicalisation, sealed daily segments chained by a Merkle root computed in code, the relay from a component's outbox, and a verifier that runs with every service off.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fps4/maestro.git",
    "directory": "spine"
  },
  "homepage": "https://github.com/fps4/maestro/tree/main/spine#readme",
  "bugs": {
    "url": "https://github.com/fps4/maestro/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "spine-verify": "dist/cli/verify.js"
  },
  "files": [
    "dist",
    "!dist/lambda",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file dist/lambda/sealer.cdx.json --output-reproducible",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify": "tsx src/cli/verify.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.1"
  }
}
