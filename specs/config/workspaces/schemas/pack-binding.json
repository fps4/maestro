{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pack_binding",
  "description": "Which standards this tenant accepted, who accepted each, and when. Larger than a business case's schema because acceptances are a repeating structure and a gate reads facets, never a body.",
  "type": "object",
  "required": ["packs", "acceptances"],
  "additionalProperties": false,
  "properties": {
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack", "pinned", "upgrade"],
        "additionalProperties": false,
        "properties": {
          "pack": { "type": "string" },
          "pinned": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "upgrade": { "enum": ["notify", "auto_minor"], "description": "Never automatic on a material change." }
        }
      }
    },
    "acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standard", "scope", "accepted_by", "at", "pack_version", "standard_ordinal"],
        "additionalProperties": false,
        "properties": {
          "standard": { "type": "string" },
          "scope": { "enum": ["tenant", "project"] },
          "project": { "type": "string" },
          "standard_ordinal": { "type": "integer", "minimum": 1 },
          "pack_version": { "type": "string" },
          "at": { "type": "string", "format": "date" },
          "accepted_by": {
            "type": "object",
            "required": ["party", "role"],
            "additionalProperties": false,
            "properties": {
              "party": { "type": "string" },
              "person": { "type": "string" },
              "role": { "type": "string" },
              "instrument": { "type": "string" }
            }
          }
        }
      }
    },
    "overrides": {
      "type": "array",
      "description": "Product tier only. A regulatory standard has no override, and every override carries an expiry.",
      "items": {
        "type": "object",
        "required": ["standard", "justification", "accepted_by", "expires"],
        "additionalProperties": false,
        "properties": {
          "standard": { "type": "string" },
          "justification": { "type": "string", "minLength": 10 },
          "accepted_by": { "type": "string" },
          "expires": { "type": "string", "format": "date" }
        }
      }
    },
    "oversight_choices": { "type": "object", "additionalProperties": { "enum": ["O0", "O1", "O2", "O3", "O4"] } },
    "consequence_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["c1", "c2", "c3", "c4"] },
        "escalate_when": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["predicate", "class"],
            "additionalProperties": false,
            "properties": {
              "predicate": { "type": "string" },
              "class": { "enum": ["c1", "c2", "c3", "c4"] }
            }
          }
        }
      }
    },
    "isolation_level": { "enum": ["L1", "L2"] }
  }
}
